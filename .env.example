# Optional Meta Graph API tokens for automatically fetching live Instagram & Facebook posts on /media.
# Without these tokens, /media falls back to verified curated links and click-to-load embeds.
# YouTube automatically fetches the latest uploads via YouTube's public Atom feed with hourly revalidation.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=61552959415479
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional webhook URL (e.g. Formspree, Make, Slack, or custom endpoint) to forward /api/enquiry submissions.
ENQUIRY_WEBHOOK_URL=
